from os import PathLike
from typing import Any, Mapping, Optional, Sequence, Union

__version__: str
SCENE_SCHEMA: dict[str, Any]
QUERY_SCHEMA: dict[str, Any]

class SpatialAmigoError(ValueError): ...
class SceneError(SpatialAmigoError): ...
class QueryError(SpatialAmigoError): ...
class ParseError(SpatialAmigoError): ...
class ReferenceError(SpatialAmigoError): ...

class Scene:
    def __init__(self, data: Union[Mapping[str, Any], str]) -> None: ...
    @staticmethod
    def from_file(path: Union[str, PathLike[str]]) -> Scene: ...
    @property
    def labels(self) -> list[str]: ...
    @property
    def ids(self) -> list[str]: ...
    @property
    def has_viewpoint(self) -> bool: ...
    def to_dict(self) -> dict[str, Any]: ...
    def to_json(self) -> str: ...
    def __len__(self) -> int: ...

class Resolution:
    @property
    def best(self) -> Optional[str]: ...
    @property
    def margin(self) -> float: ...
    @property
    def explanation(self) -> str: ...
    @property
    def query(self) -> dict[str, Any]: ...
    @property
    def candidates(self) -> list[dict[str, Any]]: ...
    @property
    def scores(self) -> list[tuple[str, float]]: ...
    def to_dict(self) -> dict[str, Any]: ...
    def to_json(self) -> str: ...

class Resolver:
    def __init__(
        self, scene: Union[Scene, Mapping[str, Any], str], params: Optional[Mapping[str, float]] = None
    ) -> None: ...
    def resolve(self, query: Union[str, Mapping[str, Any]]) -> Resolution: ...
    def resolve_many(
        self, queries: Sequence[Union[str, Mapping[str, Any]]]
    ) -> list[Union[Resolution, SpatialAmigoError]]: ...
    @property
    def scene(self) -> Scene: ...
    @property
    def params(self) -> dict[str, float]: ...

def parse(text: str, labels: Optional[Sequence[str]] = None) -> dict[str, Any]: ...
def validate_query(query: Union[Mapping[str, Any], str]) -> dict[str, Any]: ...
def default_params() -> dict[str, float]: ...
